APP_NAME="ERP Demo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=demo_db
DB_USERNAME=erp
DB_PASSWORD=erp-change-this-password

# MySQL container uses the same canonical database and application credentials.
MYSQL_DATABASE=demo_db
MYSQL_USER=erp
MYSQL_PASSWORD=erp-change-this-password
MYSQL_ROOT_PASSWORD=root-change-this-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
